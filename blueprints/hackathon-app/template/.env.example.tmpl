# Environment variables for {{ .Name }}
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and should never be committed.
{{ if .WithAi }}
# Required for the AI route (/api/ai).
ANTHROPIC_API_KEY=
{{ end }}{{ if or .WithAuth .WithDatabase }}
# Required for Supabase auth and/or database.
# Get these from your project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
{{ end -}}
