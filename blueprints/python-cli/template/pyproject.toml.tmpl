[project]
name = "{{ .Name }}"
version = "0.1.0"
description = "{{ .Description }}"
requires-python = ">=3.12"
dependencies = [
    "typer>=0.12.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.4.0",
    "ruff>=0.1.14",
]

[project.scripts]
{{ .Name | replace "-" "_" }} = "src.main:app"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src"]

[tool.ruff]
line-length = 100
target-version = "py312"

[tool.ruff.lint]
select = ["E", "F", "I", "W", "B", "C90"]

[tool.pytest.ini_options]
testpaths = ["tests"]
